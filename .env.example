# Copier ce fichier en .env et adapter les valeurs pour la production

# Clé secrète Django — générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changez-cette-cle-secrete-en-production

# Mettre False en production
DJANGO_DEBUG=False

# Domaines autorisés (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,mondomaine.ci,www.mondomaine.ci
